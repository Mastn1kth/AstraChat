{
  "name": "tg",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --watch server/index.js",
    "server:start": "node server/index.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "npm run test:server && npm run test:client",
    "test:server": "node --test server/*.test.js",
    "test:client": "vitest run src",
    "mobile:sync": "vite build && npx cap sync",
    "mobile:android": "vite build && npx cap sync android && npx cap open android",
    "mobile:ios": "vite build && npx cap sync ios && npx cap open ios",
    "db:migrate": "node server/db-cli.js migrate",
    "db:status": "node server/db-cli.js status",
    "db:rollback": "node server/db-cli.js rollback"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "@aws-sdk/lib-storage": "^3.1063.0",
    "@capacitor/android": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/push-notifications": "^8.1.1",
    "@electric-sql/pglite": "^0.5.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.17.0",
    "multer": "^2.1.1",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^5.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-window": "^2.2.7",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12",
    "vitest": "^4.0.15"
  }
}
