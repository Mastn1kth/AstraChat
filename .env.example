PORT=3001
HOST=127.0.0.1
ALLOWED_ORIGINS=
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
MESSAGE_ENCRYPTION_KEY=

# Generate VAPID keys with:
# node -e "import('web-push').then(({default:w})=>console.log(w.generateVAPIDKeys()))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# WebRTC ICE servers. Development can use public STUN; production also requires TURN/TURNS.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_TURN_URLS=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
