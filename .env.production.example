NODE_ENV=production
HOST=0.0.0.0
PORT=3001
TRUST_PROXY=1
# Public website plus native Capacitor origins.
ALLOWED_ORIGINS=https://onda.gory-staff.ru,https://localhost,capacitor://localhost
# Required when the native app calls an API hosted on another domain.
SESSION_COOKIE_SAME_SITE=none

# Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
MESSAGE_ENCRYPTION_KEY=

# Web Push VAPID keys. Generate with:
# node -e "import('web-push').then(({default:w})=>console.log(w.generateVAPIDKeys()))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# WebRTC ICE servers. Production requires at least one TURN/TURNS URL.
# Either use the split variables below or WEBRTC_ICE_SERVERS as JSON.
WEBRTC_STUN_URLS=stun:stun.example.com:3478
WEBRTC_TURN_URLS=turns:turn.example.com:5349
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
# WEBRTC_ICE_SERVERS=[{"urls":["stun:stun.example.com:3478"]},{"urls":["turns:turn.example.com:5349"],"username":"user","credential":"secret"}]

# Managed PostgreSQL in real production. docker-compose overrides this for local infra.
DATABASE_URL=postgres://user:password@host:5432/astrachat?sslmode=require
PG_POOL_MAX=10

# Managed Redis/Valkey in real production. docker-compose overrides this for local infra.
REDIS_URL=redis://host:6379/0

# S3-compatible object storage: AWS S3, Cloudflare R2, Backblaze B2, MinIO.
STORAGE_DRIVER=s3
S3_BUCKET=astrachat
S3_ENDPOINT=https://s3.example.com
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=media
